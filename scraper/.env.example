# MePonto ingest endpoint + shared secret (must equal EASTWIND_INGEST_TOKEN on the server)
MEPONTO_INGEST_URL=https://sys.meponto.com/api/eastwind/rider-status
MEPONTO_INGEST_TOKEN=change-me

# Persistent browser profile (keeps the Eastwind login session)
PROFILE_DIR=./.eastwind-profile

# Eastwind / capture settings
CITY_ID=55000199
INTERVAL_MIN=5

# Shift window (HH:MM in TZ). Scraper only pulls inside this window.
SHIFT_START=10:30
SHIFT_END=22:30
TZ=America/Sao_Paulo

# Set HEADLESS=false to watch the browser during debugging
HEADLESS=true

# Optional: alert webhook for LOGIN_REQUIRED / ingest failures (Slack/Discord/Zapier).
# Leave empty to only log. Slack & Discord incoming webhooks both work.
ALERT_WEBHOOK_URL=
