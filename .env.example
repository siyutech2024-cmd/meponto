# MePonto / PontoSys environment template
# Copy to .env.local for local development. Never commit real secrets.

# App
NEXT_PUBLIC_APP_NAME="MePonto PontoSys"
NEXT_PUBLIC_APP_ENV="development"
AUTH_SESSION_SECRET=""

# Sign in with Google (rider). Create an OAuth 2.0 Web Client ID in Google
# Cloud Console and add your origins (https://app.meponto.com, http://localhost:3000).
# Leave empty to hide the Google button entirely. No client secret is needed —
# the ID token is verified server-side against Google's tokeninfo endpoint.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase server-side access
SUPABASE_SERVICE_ROLE_KEY=""

# Database persistence: when "true", every in-memory collection is mirrored to
# the Supabase app_state_records table and restored on server start.
USE_SUPABASE="true"

# Supabase Postgres connection strings
# Use pooled DATABASE_URL for app runtime and DIRECT_URL for migrations/admin jobs.
DATABASE_URL=""
DIRECT_URL=""

# Optional future services
REDIS_URL=""
SENTRY_DSN=""

# Immutable business constants
POINTS_PER_BRL="10"
QR_CODE_TTL_SECONDS="60"
QR_MAX_DISTANCE_METERS="50"
