# Release signing config for MePonto (Android).
#
# 1. Copy this file to `keystore.properties` (same folder, the project root):
#       cp keystore.properties.template keystore.properties
# 2. Fill in the values for YOUR existing keystore below.
# 3. NEVER commit keystore.properties or the .jks/.keystore file — both are
#    already in .gitignore. Keep the passwords somewhere safe (password manager).
#
# storeFile : path to your keystore, relative to the project root
#             (android-rider-app/). Absolute paths also work.
storeFile=meponto-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=meponto
keyPassword=YOUR_KEY_PASSWORD
